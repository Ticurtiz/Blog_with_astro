---
import '../styles/global.css';
import BaseLayout from '../layouts/BaseLayout.astro';

const poster = '/assets/xiao-beidou-poster.png';
---

<BaseLayout title="PROJECTS">
  <main class="projects-page" data-project-hero>
    <section class="beidou-hero" aria-labelledby="beidou-title">
      <div class="poster-layer" aria-hidden="true">
        <img src={poster} alt="" loading="eager" decoding="async" />
      </div>
      <div class="poster-wash" aria-hidden="true"></div>
      <div class="giant-type" aria-hidden="true">小北斗</div>

      <div class="hero-copy">
        <p class="eyebrow">2025 PROJECT SHOWCASE</p>
        <h1 id="beidou-title">小北斗</h1>
        <p class="roman">XIAO BEIDOU</p>
        <p class="tagline">激光打击 · 智能识别</p>
        <ul class="feature-strip" aria-label="小北斗核心能力">
          <li>精准识别</li>
          <li>自动瞄准</li>
          <li>智能打击</li>
        </ul>
      </div>

      <div class="scroll-cue" aria-hidden="true"></div>
    </section>

    <section class="project-brief" aria-label="小北斗项目介绍">
      <div class="brief-copy">
        <p class="kicker">INTELLIGENT ROBOT WARRIOR</p>
        <h2>面向机器人攻防实验的视觉识别与激光定位作品。</h2>
        <p>
          小北斗将机械底盘、视觉感知和激光指示整合成一套紧凑的演示系统，用电影海报式的方式呈现它的冷峻、精密和行动感。
        </p>
      </div>
    </section>
  </main>

  <script is:inline>
    const hero = document.querySelector('[data-project-hero]');
    const root = document.documentElement;

    const syncProjectScroll = () => {
      if (!hero) return;
      const rect = hero.getBoundingClientRect();
      const distance = Math.max(1, hero.offsetHeight - window.innerHeight);
      const progress = Math.min(1, Math.max(0, -rect.top / distance));
      root.style.setProperty('--project-scroll', progress.toFixed(4));
    };

    syncProjectScroll();
    window.addEventListener('scroll', syncProjectScroll, { passive: true });
    window.addEventListener('resize', syncProjectScroll, { passive: true });
  </script>
</BaseLayout>

<style>
  :global(:root) {
    --project-scroll: 0;
  }

  .projects-page {
    width: 100vw;
    min-height: 245vh;
    margin-left: calc(50% - 50vw);
    margin-right: calc(50% - 50vw);
    color: #fff;
    background: #03070b;
    font-family: 'JetBrains Mono', monospace;
    overflow-x: clip;
  }

  .beidou-hero {
    position: sticky;
    top: 0;
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    place-items: center;
    overflow: hidden;
    isolation: isolate;
  }

  .poster-layer,
  .poster-wash {
    position: absolute;
    inset: 0;
  }

  .poster-layer {
    z-index: -3;
    transform: scale(calc(1.17 - var(--project-scroll) * 0.09))
      translateY(calc(var(--project-scroll) * -3vh));
    filter: saturate(calc(0.82 + var(--project-scroll) * 0.28)) contrast(1.08);
    will-change: transform, filter;
  }

  .poster-layer img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center 54%;
    opacity: calc(0.5 + var(--project-scroll) * 0.42);
  }

  .poster-wash {
    z-index: -2;
    background:
      radial-gradient(circle at 50% 48%, rgba(124, 160, 190, 0.06), rgba(0, 0, 0, 0.42) 48%, #020509 86%),
      linear-gradient(180deg, rgba(2, 5, 9, 0.72), rgba(2, 5, 9, 0.28) 48%, rgba(2, 5, 9, 0.82));
  }

  .giant-type {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 50%;
    width: 120vw;
    transform: translate(-50%, -50%) scale(calc(2.25 - var(--project-scroll) * 1.08));
    color: rgba(0, 0, 0, calc(0.88 - var(--project-scroll) * 0.12));
    font-size: clamp(8rem, 23vw, 30rem);
    font-weight: 900;
    line-height: 0.88;
    text-align: center;
    letter-spacing: 0;
    opacity: calc(0.34 + var(--project-scroll) * 0.58);
    text-shadow: 0 0 1px rgba(255, 255, 255, 0.08);
    white-space: nowrap;
    will-change: transform, opacity;
  }

  .hero-copy {
    width: min(92vw, 58rem);
    padding: 0 1rem;
    text-align: center;
    transform: translateY(calc(8vh - var(--project-scroll) * 8vh))
      scale(calc(1.04 - var(--project-scroll) * 0.04));
    opacity: clamp(0, calc((var(--project-scroll) - 0.28) * 1.65), 1);
    will-change: transform, opacity;
  }

  .eyebrow,
  .roman,
  .tagline,
  .feature-strip {
    text-shadow: 0 0 20px rgba(0, 0, 0, 0.85);
  }

  .eyebrow {
    margin: 0 0 1.3rem;
    color: rgba(235, 240, 246, 0.78);
    font-size: clamp(0.78rem, 1.4vw, 1rem);
    letter-spacing: 0.18em;
  }

  h1 {
    margin: 0;
    color: #f7f9fb;
    font-size: clamp(4.5rem, 15vw, 15rem);
    font-weight: 900;
    line-height: 0.86;
    text-shadow: 0 0 34px rgba(214, 227, 238, 0.38), 0 24px 80px rgba(0, 0, 0, 0.7);
  }

  .roman {
    margin: 1.2rem 0 0;
    color: rgba(244, 248, 252, 0.78);
    font-size: clamp(1rem, 2.2vw, 1.7rem);
    letter-spacing: clamp(0.42em, 1vw, 0.72em);
  }

  .tagline {
    margin: 1.7rem 0 0;
    color: rgba(250, 253, 255, 0.9);
    font-size: clamp(1.15rem, 2.6vw, 2.1rem);
    letter-spacing: 0.24em;
  }

  .feature-strip {
    display: flex;
    justify-content: center;
    gap: clamp(1rem, 4vw, 3.6rem);
    padding: 0;
    margin: 2.2rem 0 0;
    list-style: none;
    color: rgba(245, 249, 253, 0.78);
    font-size: clamp(0.82rem, 1.5vw, 1rem);
    letter-spacing: 0.24em;
  }

  .feature-strip li + li::before {
    content: "|";
    margin-right: clamp(1rem, 4vw, 3.6rem);
    color: rgba(255, 255, 255, 0.3);
  }

  .scroll-cue {
    position: absolute;
    bottom: max(2rem, env(safe-area-inset-bottom));
    left: 50%;
    width: 3.3rem;
    height: 3.3rem;
    border: 1px solid rgba(255, 255, 255, 0.28);
    border-radius: 999px;
    transform: translateX(-50%);
    opacity: calc(0.78 - var(--project-scroll) * 0.78);
  }

  .scroll-cue::before {
    content: "";
    position: absolute;
    inset: 1rem 1.15rem 1.25rem;
    border-right: 3px solid rgba(255, 220, 226, 0.88);
    border-bottom: 3px solid rgba(255, 220, 226, 0.88);
    transform: rotate(45deg);
  }

  .project-brief {
    min-height: 100vh;
    min-height: 100dvh;
    display: grid;
    align-items: end;
    padding: clamp(5rem, 10vw, 9rem) clamp(1rem, 7vw, 7rem);
    background:
      linear-gradient(180deg, rgba(3, 7, 11, 0), #03070b 16%),
      radial-gradient(circle at 80% 18%, rgba(93, 138, 164, 0.24), transparent 38%),
      #03070b;
  }

  .brief-copy {
    max-width: 56rem;
  }

  .kicker {
    margin: 0 0 1.1rem;
    color: rgba(210, 222, 232, 0.6);
    letter-spacing: 0.48em;
  }

  h2 {
    margin: 0;
    color: #f5f7f8;
    font-size: clamp(2.5rem, 7vw, 6.6rem);
    line-height: 0.98;
  }

  .brief-copy p:last-child {
    max-width: 42rem;
    margin: 1.4rem 0 0;
    color: rgba(235, 241, 246, 0.72);
    font-size: clamp(1rem, 1.7vw, 1.2rem);
    line-height: 1.8;
  }

  html[data-device='mobile'][data-orientation='portrait'] .projects-page {
    min-height: 230vh;
  }

  html[data-device='mobile'][data-orientation='portrait'] .poster-layer img {
    object-position: center bottom;
  }

  html[data-device='mobile'][data-orientation='portrait'] .giant-type {
    width: 160vw;
    font-size: clamp(5.8rem, 25vw, 10rem);
    transform: translate(-50%, -50%) scale(calc(2 - var(--project-scroll) * 0.92));
  }

  html[data-device='mobile'][data-orientation='portrait'] .hero-copy {
    width: min(92vw, 24rem);
    padding-top: 2rem;
  }

  html[data-device='mobile'][data-orientation='portrait'] h1 {
    font-size: clamp(4rem, 24vw, 6.4rem);
  }

  html[data-device='mobile'][data-orientation='portrait'] .roman {
    letter-spacing: 0.32em;
  }

  html[data-device='mobile'][data-orientation='portrait'] .tagline {
    letter-spacing: 0.12em;
  }

  html[data-device='mobile'][data-orientation='portrait'] .feature-strip {
    flex-direction: column;
    gap: 0.65rem;
    letter-spacing: 0.18em;
  }

  html[data-device='mobile'][data-orientation='portrait'] .feature-strip li + li::before {
    content: none;
  }

  @media (prefers-reduced-motion: reduce) {
    .poster-layer,
    .giant-type,
    .hero-copy {
      transform: none;
    }
  }
</style>
