/></h1>
  <p class="subtitle">  
    <TextType 
    client:load
    initialDelay={330}
    typingSpeed={39}
  text={["Under Construction..."]}
  showCursor={false}
  variableSpeed={false}
  onSentenceComplete={() => {}}


  
  <p class="subtext">I am working hardly...</p>
</div>

<div class="fixed inset-x-0 bottom-0 z-50">

    <Footer />
  </div>
