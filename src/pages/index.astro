---
// 完全保留你原来的代码
import '../styles/global.css';
import Footer from '../components/Footer.astro';  
import ColorBends from '../components/ColorBends';
import BaseLayout from '../layouts/BaseLayout.astro';
import TextType from '../components/TextType.jsx';
const pageTitle = "首页";
const menuItems = [
  { label: 'Index', ariaLabel: 'Go to home page', link: '/' },
  { label: 'About', ariaLabel: 'Learn about us', link: '/about/' },
  { label: 'Blog', ariaLabel: 'View blog', link: '/blog/' }
];

const socialItems = [
  { label: 'GitHub', link: 'https://github.com' },

];
---
<BaseLayout title="首页">
<html lang="zh-cn">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content={Astro.generator}>
    <title>{pageTitle}</title>

    <link rel="stylesheet" href="/fonts.css" />

    <style>   


        .site-backdrop {
  position: fixed;
  inset: 0;
  z-index: -20; /* 确保它在所有东西的最底层 */
  background: #000000; /* 纯黑色 */
}

      {
        font-family: 'JetBrains Mono', monospace !important;
        color: #ffffff !important;
      }
       h1 {
        color: rgb(255, 255, 255);
        font-size: 4rem;
        font-family: 'JetBrains Mono', monospace;
        margin: 0 0 1rem 0;
      }

      .subtitle {
        color: rgb(255, 255, 255);
        font-size: 2rem;
        margin: 0.5rem 0;
        font-family: 'JetBrains Mono', monospace;
      }
      .subtext {
        color: rgb(255, 255, 255);
        font-size: 1.2rem;
        font-family: 'JetBrains Mono', monospace;
        margin: 0;
      }
      .navigation-container {
  padding-left: 2rem; /* 左边距 32px，适中偏左 */
  /* 或者用 margin-left: 2rem; */
  }

    </style>
  </head>
   
  <body>
    </div>
<ColorBends client:load className="ascii-bg" style={{}} />
    
