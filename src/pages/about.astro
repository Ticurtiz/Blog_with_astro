---
import '../styles/global.css';
import Navigation from '../components/Navigation.astro';
import Footer from '../components/Footer.astro';  
import BaseLayout from '../layouts/BaseLayout.astro';

const pageTitle = "关于我";

const identity = {
  firstName: "tAIeK",
  country: "CN",
  occupation: "技术撰稿人",
  hobbies: ["鸟鸟", "摄摄", ],
};
const happy = true;


const skills = ["HTML", "CSS", "JavaScript", "React", "Astro", "Writing Docs"];

const skillColor = "crimson";
const fontWeight = "bold";
const textCase = "uppercase";
---

<html lang="zh-cn">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type ="image/svg+xml" href="/favicon.svg" />
    <meta name="viewport" content="width=device-width" />
    <meta name="generator" content = {Astro.generator} >
    <title>{pageTitle}</title>
     <style>
      h1 {
        color: purple;
        font-size: 4rem;
      }
       .skill {
            color: var(--skillColor);
            font-weight: var(--fontWeight);
            text-transform: var(--textCase);    
              }
    </style>
  </head>
  
  <body>
    <Navigation />
      
      <h1>{pageTitle}</h1>
  <h2>……和我的新 Astro 网站！</h2>

  <p>我正在学习 Astro 的入门教程。这是我网站上的第二个页面，也是我自己建立的第一页面！</p>

  <p>随着我完成更多，该站点将更新，所以请继续查看我的旅程将如何进行吧！</p>
  <p>以下关于我：</p>
  <ul>
  <li>名字: {identity.firstName}</li>
  <li>职业: {identity.occupation}</li>
  <li>爱好:
  <ul>

      {identity.hobbies.map((hobby) => (
        <li>{hobby}</li>
      ))}
  </ul>

  </li> 
  {happy && <p>我非常乐意学习 Astro！</p>}

<p>我的技能是：</p>
<ul>
   {skills.map((skill) => <li class="skill">{skill}</li>)}
</ul>
</BaseLayout>
 <Footer />
  </body>
</html>