---
// src/layouts/BaseLayout.astro
import StaggeredMenu from '../components/StaggeredMenu.astro';
import '../components/StaggeredMenu.css'; // 只引入一次
export interface Props {
  title: string;
}
const { title } = Astro.props;
---

<html lang="zh-cn">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <link rel="preconnect" href="https://fonts.cat.net" />
    <link
      href="https://fonts.cat.net/css2?family=Inter:wght@400;700&family=JetBrains+Mono:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <script is:inline>
      const setViewportMode = () => {
        const root = document.documentElement;
        const isCoarsePointer = window.matchMedia('(pointer: coarse)').matches;
        const isNarrow = window.matchMedia('(max-width: 768px)').matches;
        const isTabletPortrait = window.matchMedia('(max-width: 1024px) and (orientation: portrait)').matches;
        const isMobile = isNarrow || (isCoarsePointer && isTabletPortrait);

        root.dataset.device = isMobile ? 'mobile' : 'desktop';
        root.dataset.orientation = window.matchMedia('(orientation: portrait)').matches ? 'portrait' : 'landscape';
      };

      setViewportMode();
      window.addEventListener('resize', setViewportMode, { passive: true });
      window.addEventListener('orientationchange', setViewportMode, { passive: true });
    </script>
  </head>

  <body>
    <!-- 全局导航 -->
    <StaggeredMenu
      items={[
        { label: 'Index', link: '/', ariaLabel: 'Go to home page' },
        { label: 'About', link: '/about/', ariaLabel: 'Learn about us' },
        { label: 'Blog', link: '/blog/', ariaLabel: 'View blog' },
        { label: 'PROJECTS', link: '/projects/', ariaLabel: 'View projects' }
      ]}
      socialItems={[
        { label: 'GitHub', link: 'https://github.com' }
      ]}
      position="right"
      accentColor="#5227FF"
      menuButtonColor="#ffffff"
      openMenuButtonColor="#000000"
      changeMenuColorOnOpen={true}
      pointer-events="all"
    />

    <slot />

    <div class="site-backdrop" />
  </body>
</html>

<style>
  .site-backdrop {
    position: fixed;
    inset: 0;
    z-index: -20;
    background: #000;
  }
</style>
