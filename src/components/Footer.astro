---
import Social from './Social.astro';

const platform = 'github';
---

<footer>
  <div class="footer-inner">
    <p>
      © 2025 TAIKE |
      On <a href="https://github.com/Ticurtiz" class="footer-link">{platform}</a>, learn more about my projects
    </p>
    <Social platform="Only_for_91vip" username="NULL!" />
  </div>
</footer>

<style>
  footer {
    padding: 0 max(1rem, env(safe-area-inset-right)) max(0.9rem, env(safe-area-inset-bottom))
      max(1rem, env(safe-area-inset-left));
    pointer-events: none;
  }

  .footer-inner {
    z-index: 50;
    max-width: min(100%, 42rem);
    color: #0090fe;
  }

  .footer-link {
    color: #c7ffd5 !important;
    text-decoration: none !important;
    position: relative;
    transition: all 0.3s ease;
    font-weight: 500;
    pointer-events: all;
  }

  .footer-link:hover {
    color: #c1ffd0 !important;
    text-shadow: 0 0 2px rgb(182, 248, 245);
    transform: translateY(-1px);
  }

  p {
    color: rgb(255, 255, 255);
    font-family: 'JetBrains Mono', monospace;
    margin: 0 0 0.25rem;
    line-height: 1.45;
  }

  @media (max-width: 640px) {
    footer {
      padding-right: max(0.9rem, env(safe-area-inset-right));
      padding-left: max(0.9rem, env(safe-area-inset-left));
    }

    .footer-inner {
      font-size: 0.92rem;
    }
  }
</style>
