---
const { platform, username } = Astro.props;
---
<style>
.footer-link {
  color: #c7ffd5 !important;           /* 默认绿色 */
  text-decoration: none !important;
  position: relative;
  transition: all 0.3s ease;
  font-weight: 500;
  pointer-events: all !important;
}
.footer-link:hover {
  color: #c1ffd0 !important;           /* 悬停变亮绿 */
  text-shadow: 0 0 1px rgb(169, 246, 221);          /* 发光 */
  transform: translateY(-1px);
}
</style>
<a href={`https://www.bilibili.com/`} class="footer-link">{platform}</a>